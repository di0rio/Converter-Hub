{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "description": "Web interface for extracting databases and tables from MySQL, MariaDB and PostgreSQL dumps",
  "scripts": {
    "dev": "next dev",
    "build": "bun run --filter @sql-extractor/core build && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "setup": "node scripts/ensure-react-symlinks.mjs",
    "test": "bun run --filter @sql-extractor/core build && node scripts/ensure-react-symlinks.mjs && vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@daypicker/react": "^10.0.1",
    "@sql-extractor/core": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^25.0.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "bun@1.4.0",
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
