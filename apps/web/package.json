{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "description": "Web interface for Converter Hub: local tools for splitting spreadsheets and extracting database dumps",
  "scripts": {
    "dev": "node scripts/copy-sqlite-wasm.mjs && next dev",
    "build": "bun run --filter @sql-extractor/core build && node scripts/copy-sqlite-wasm.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "setup": "node scripts/ensure-react-symlinks.mjs",
    "test": "bun run --filter @sql-extractor/core build && node scripts/ensure-react-symlinks.mjs && node scripts/copy-sqlite-wasm.mjs && vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@daypicker/react": "^10.0.1",
    "@sql-extractor/core": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "marked": "^18.0.12",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "wa-sqlite": "^1.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "fflate": "^0.8.3",
    "jsdom": "^25.0.0",
    "tailwindcss": "^4",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "bun@1.4.0",
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
