{
  "name": "sql-extractor",
  "version": "0.1.0",
  "private": true,
  "description": "CLI for extracting databases and tables from MySQL, MariaDB and PostgreSQL dumps",
  "type": "module",
  "bin": {
    "sql-extractor": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "bun run --filter @sql-extractor/core build && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sql-extractor/core": "workspace:*",
    "commander": "^12.0.0",
    "prompts": "^2.4.2",
    "wa-sqlite": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/prompts": "^2.4.0",
    "fflate": "^0.8.3",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
